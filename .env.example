# Server port
PORT=3000

# Host to bind to
HOST=0.0.0.0

# JWT secret key for signing auth tokens
# *** MUST be changed to a strong random string in production ***
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_hex_string

# Create the first administrator locally with npm run admin or npm run users.
# Web registration requires a one-use viewer invitation.

# CORS origin for production (set to your domain, e.g. https://example.com)
# CORS_ORIGIN=

# Transmission daemon URL for torrent downloads (optional)
# TRANSMISSION_URL=http://localhost:9091/transmission/rpc

# Optional OrbStack/Compose torrent daemon, see README.
# TRANSMISSION_USER=mediapiayer
# TRANSMISSION_PASSWORD=use-a-long-random-password
# TRANSMISSION_UID=501
# TRANSMISSION_GID=20
# TRANSMISSION_DOWNLOAD_DIR=/absolute/path/to/mediaPiayer/media/.downloads

# Optional external directory for CLI database/config backups
# ADMIN_BACKUP_DIR=/mnt/backup/mediapiayer
