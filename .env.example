# Server port
PORT=3000

# Host to bind to
HOST=0.0.0.0

# JWT secret key for signing auth tokens
# *** MUST be changed to a strong random string in production ***
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_hex_string

# Admin invite code for registering admin accounts
# When set, users can only become admin by providing this code during registration
# When empty, the first registered user becomes admin automatically
# ADMIN_INVITE_CODE=

# CORS origin for production (set to your domain, e.g. https://example.com)
# CORS_ORIGIN=

# Transmission daemon URL for torrent downloads (optional)
# TRANSMISSION_URL=http://localhost:9091/transmission/rpc
