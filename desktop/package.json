{
  "name": "mediapiayer-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MediaPiayer con collegamento privato Tailscale integrato",
  "author": "MediaPiayer",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "helper:build": "node scripts/build-helper.cjs",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run helper:build && npm run licenses && electron-builder --dir",
    "dist": "npm run helper:build && npm run licenses && electron-builder",
    "dist:mac": "npm run helper:build && npm run licenses && electron-builder --mac",
    "dist:win": "npm run helper:build && npm run licenses && electron-builder --win --x64",
    "licenses": "node scripts/licenses.cjs",
    "smoke": "electron tests/smoke.cjs",
    "dist:linux": "npm run helper:build && npm run licenses && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.mediapiayer.desktop",
    "productName": "MediaPiayer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "validation.cjs",
      "ui/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/${os}-${arch}",
        "to": "helper"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "icons/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "MediaPiayer"
    }
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
