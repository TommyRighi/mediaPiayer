NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Replace with a distinct secret generated locally with openssl rand -hex 32.
JWT_SECRET=
# Exact HTTPS origin shown by tailscale serve status. No trailing slash.
PUBLIC_ORIGIN=https://raspberry.example-tailnet.ts.net
COOKIE_SECURE=true
MEDIA_DIRS=/srv/mediapiayer
DATABASE_PATH=/opt/mediapiayer/data/mediapiayer.db
SOCIAL_ENABLED=false
ENABLE_DOWNLOADS=false
