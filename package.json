{
  "name": "mediapiayer",
  "version": "1.0.0",
  "description": "Self-hosted Netflix-like media streaming from a Raspberry Pi",
  "main": "server/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env server/server.js",
    "dev:all": "concurrently -n server,client -c cyan,magenta \"npm run dev\" \"cd frontend && npm run dev\"",
    "start": "node --env-file=.env server/server.js",
    "build": "cd frontend && npm run build && cd .. && node scripts/verify-build.js",
    "deploy": "npm install && cd frontend && npm install && npm run build && cd .. && npm start",
    "transcode:start": "node scripts/transcode.js start",
    "transcode:status": "node scripts/transcode.js status",
    "transcode:retry": "node scripts/transcode.js retry",
    "transcode:list": "node scripts/transcode.js list",
    "test": "node --test tests/*.test.cjs",
    "desktop:install": "npm ci --prefix desktop",
    "desktop:start": "npm start --prefix desktop",
    "desktop:build": "npm run dist --prefix desktop",
    "users": "node --env-file=.env scripts/users.js",
    "admin": "node scripts/admin.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "diskusage": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "music-metadata": "^11.16.1",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22"
  },
  "overrides": {
    "@fastify/static": {
      "content-disposition": "^2.0.0"
    }
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
